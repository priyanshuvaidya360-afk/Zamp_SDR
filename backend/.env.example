# Copy to backend/.env and fill in. Never commit backend/.env.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# live | record | fixtures (see docs/GUIDE.md, T03)
DEMO_MODE=live

# Defaults to SQLite at backend/signal.db; set a Postgres URL when deployed.
# DATABASE_URL=postgresql://user:pass@host/db

# JSON list of allowed frontend origins.
# CORS_ORIGINS=["http://localhost:3000"]
