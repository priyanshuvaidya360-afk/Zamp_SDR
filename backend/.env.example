# Template only: copy to backend/.env and put real keys THERE, never in this file.
# This file is committed and the repo is public. Every key below is free, no credit card.

# LLM, primary: https://console.groq.com/keys
GROQ_API_KEY=
# LLM, fallback: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Search, primary (1,000 free credits/month): https://app.tavily.com
TAVILY_API_KEY=
# Search, optional last resort (free monthly credits): https://dashboard.exa.ai
# DuckDuckGo needs no key and sits between Tavily and Exa.
EXA_API_KEY=

# live | record | fixtures (see docs/PROJECT_SPEC.md, T03)
DEMO_MODE=live

# Defaults to SQLite at backend/signal.db. Deployed: Neon's pooled URL, plus the direct one
# for startup schema work (both are in the repo-root .env.local after `neon deploy`).
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# JSON list of allowed frontend origins.
# CORS_ORIGINS=["http://localhost:3000"]

# Optional model overrides (defaults in app/config.py).
# GROQ_SMART_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GEMINI_SMART_MODEL=gemini-3.6-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
